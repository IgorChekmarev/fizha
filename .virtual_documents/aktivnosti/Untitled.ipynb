import numpy as np
import matplotlib.pyplot as plt
pH = np.array([1.68, 4, 7])
e = np.array([332.5, 195, 23.5])
plt.scatter(pH, e)
plt.xlabel('рН')
plt.ylabel('E, мВ')


coeffs_2 = np.polyfit(pH, e, 1)
poly_2 = np.poly1d(coeffs_2)
x_smooth = np.linspace(min(pH), max(pH), 100)
y_smooth_2 = poly_2(x_smooth)
plt.plot(x_smooth, y_smooth_2, label=f'Экспериментальная калибровка: y = {coeffs_2[0]:.3f}x + {coeffs_2[1]:.3f}')
plt.legend()
plt.grid()

plt.show()


